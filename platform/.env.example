# ===========================================================================
# LMPC Compliance Platform - environment configuration
# Copy to .env and adjust. Passwords with special characters are safe in .env.
# ===========================================================================

# --- Application ----------------------------------------------------------
APP_NAME=LMPC Compliance Platform
API_PREFIX=/api
DEBUG=true

# --- Database (PostgreSQL) --------------------------------------------------
# Driver "psycopg" = psycopg3. Special chars in password like $ are fine here.
DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/lmpc_platform
# For tests (do not change default; sqlite keeps CI self-contained)
TEST_DATABASE_URL=sqlite://

# --- Auth / JWT --------------------------------------------------------------
# Generate a long random secret for production:  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

# --- CV/OCR engine (teammate service, read-only from here) -------------------
ENGINE_BASE_URL=http://127.0.0.1:8000
ENGINE_TIMEOUT_SECONDS=60.0

# --- Object storage -----------------------------------------------------------
# storage_backend: local | s3   (s3 falls back to local if connection fails)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage_data
S3_BUCKET=lmpc-platform
S3_REGION=ap-south-1
S3_ENDPOINT_URL=            # set for MinIO, e.g. http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Demo / seed --------------------------------------------------------------
# Directory of the CV-OCR engine demo compliance reports (read-only import).
DEMO_IMPORT_DIR=../Compliance_Engine_CV_NLP/data/demo/reports
# Seed demo users + import demo inspections on first boot (true|false|force)
SEED_DEMO=true

# --- CORS ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Limits ----------------------------------------------------------------------
MAX_UPLOAD_MB=15